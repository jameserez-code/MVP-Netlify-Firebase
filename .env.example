# Passport Agent — Environment Variables
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# =============================================================================
# REQUIRED: Secrets (generate strong random values)
# =============================================================================

# JWT signing secret (for auth tokens)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REPLACE_WITH_HEX_SECRET_64_CHARS_MINIMUM

# Gateway ticket signing secret (shared between SDK + server)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENGINE_SECRET=REPLACE_WITH_HEX_SECRET_64_CHARS_MINIMUM

# Default organization ID (no hardcoded IDs in production)
DEFAULT_ORG_ID=org_your_org_id_here

# Admin password for seed/demo users
# If not set, a random password will be generated and logged on first boot
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# =============================================================================
# REQUIRED: Firebase Admin SDK credentials
# Provide EITHER option A OR option B
# =============================================================================

# Option A — Environment variables (recommended for deployments)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n
# Option B — Service account JSON file (recommended for local dev)
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# =============================================================================
# OPTIONAL

# Email notifications via Resend (https://resend.com)
RESEND_API_KEY=re_your_resend_api_key
FROM_EMAIL=onboarding@resend.dev

# Server port (default: 3000)
PORT=3000

# CORS allowed origins in production (comma-separated)
ALLOWED_ORIGINS=https://passport-agent-demo.netlify.app,http://localhost:3001

# Stripe billing (test mode keys recommended for development)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Frontend app URL (used for checkout/cancel redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Demo scripts / TUI credentials (only needed for running demos)
# DEMO_EMAIL=admin@acmecorp.com
# DEMO_PASSWORD=REPLACE_WITH_ADMIN_PASSWORD_ABOVE
