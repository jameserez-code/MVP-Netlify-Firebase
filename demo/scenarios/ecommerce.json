      "status": "active",
      "description": "Monitors stock levels, predicts reorder points, generates purchase orders (draft only)",
      "capabilities": ["check_stock", "forecast_demand", "draft_purchase_order", "flag_low_stock"],
      "registeredAt": "2025-02-15T08:30:00Z",
      "lastSeenAt": "2025-05-21T17:25:00Z"
    },
    {
      "id": "agent_order_processor_03",
      "name": "Order Processor",
      "model": "gpt-4-turbo",
      "provider": "openai",
      "status": "active",
