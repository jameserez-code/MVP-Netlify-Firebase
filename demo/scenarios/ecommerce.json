      "capabilities": ["process_order", "validate_payment", "update_fulfillment", "generate_invoice"],
      "registeredAt": "2025-02-15T09:00:00Z",
      "lastSeenAt": "2025-05-21T17:20:00Z"
    },
    {
      "id": "agent_fraud_detector_04",
      "name": "Fraud Detector",
      "model": "claude-3-sonnet-20240229",
      "provider": "anthropic",
      "status": "active",
      "description": "Scans orders for fraud patterns, flags suspicious transactions",
      "capabilities": ["scan_transaction", "flag_suspicious", "lookup_ip_geolocation", "analyze_order_pattern"],
      "registeredAt": "2025-02-15T09:30:00Z",
      "lastSeenAt": "2025-05-21T17:15:00Z"
    }
  ],
  "policies": [
    {
      "id": "pol_catalog_read_only",
      "name": "Catalog Read-Only",
      "description": "Only read catalog data — no price changes, no product modifications",
      "priority": 10,
      "scope": { "agentId": "agent_recommendation_01" },
      "rules": {
        "allowedTools": [
          { "toolName": "query_catalog", "parameterConstraints": { "query": { "type": "string", "maxLength": 300 } } },
          { "toolName": "lookup_product", "parameterConstraints": { "sku": { "type": "string" } } },
          {
            "toolName": "generate_recommendations",
            "parameterConstraints": {
              "userId": { "type": "string" },
              "limit": { "type": "number", "max": 20 }
            }
          },
          { "toolName": "analyze_browsing_history", "parameterConstraints": { "userId": { "type": "string" }, "days": { "type": "number", "max": 90 } } }
        ],
        "deniedTools": ["update_price", "modify_product", "delete_product", "create_product", "bulk_update_catalog"],
        "dataRestrictions": {
          "denyPiiInParameters": true
        }
      },
      "status": "active",
      "createdAt": "2025-02-15T10:00:00Z"
    },
    {
      "id": "pol_inventory_draft_only",
      "name": "Inventory Draft-Only",
      "description": "Inventory analysis and forecasting allowed, but purchase orders are drafts requiring human approval",
      "priority": 10,
      "scope": { "agentId": "agent_inventory_02" },
      "rules": {
        "allowedTools": [
          { "toolName": "check_stock", "parameterConstraints": { "sku": { "type": "string" } } },
          { "toolName": "forecast_demand", "parameterConstraints": { "sku": { "type": "string" }, "horizon": { "type": "number", "max": 90 } } },
          {
            "toolName": "draft_purchase_order",
            "parameterConstraints": {
              "supplier": { "type": "string" },
              "items": { "type": "string" },
              "status": { "type": "string", "enum": ["draft"] }
            }
          },
          { "toolName": "flag_low_stock", "parameterConstraints": { "threshold": { "type": "number" } } }
        ],
        "deniedTools": ["submit_purchase_order", "approve_purchase_order", "adjust_stock_level", "write_off_inventory"],
        "dataRestrictions": {
          "denySecretsInParameters": true
        }
      },
      "status": "active",
      "createdAt": "2025-02-15T10:30:00Z"
    },
    {
      "id": "pol_financial_read_only",
      "name": "Financial Read-Only",
      "description": "No agent can modify financial data — view invoices, payments, and refunds only",
      "priority": 20,
      "scope": { "agentId": "*" },
      "rules": {
        "allowedTools": [
          { "toolName": "validate_payment", "parameterConstraints": { "transactionId": { "type": "string" } } },
          {
            "toolName": "generate_invoice",
            "parameterConstraints": {
              "orderId": { "type": "string", "pattern": "^ORD-[0-9]{6,}$" }
            }
          }
        ],
        "deniedTools": [
          "process_refund",
          "void_payment",
          "adjust_pricing",
          "apply_discount",
          "issue_credit",
          "modify_invoice"
        ],
        "dataRestrictions": {
          "denyPiiInParameters": true,
          "denySecretsInParameters": true
        }
      },
      "status": "active",
      "createdAt": "2025-02-15T11:00:00Z"
    },
    {
      "id": "pol_fraud_safe_external",
      "name": "Fraud Detection — Safe External Calls",
      "description": "Allow fraud detection lookups to trusted services only",
      "priority": 10,
      "scope": { "agentId": "agent_fraud_detector_04" },
      "rules": {
        "allowedTools": [
          { "toolName": "scan_transaction", "parameterConstraints": { "transactionId": { "type": "string" } } },
          { "toolName": "flag_suspicious", "parameterConstraints": { "transactionId": { "type": "string" }, "reason": { "type": "string" } } },
          { "toolName": "analyze_order_pattern", "parameterConstraints": { "userId": { "type": "string" }, "window": { "type": "number", "max": 168 } } },
          {
            "toolName": "lookup_ip_geolocation",
            "parameterConstraints": {
              "ip": { "type": "string" }
            }
          }
        ],
        "deniedTools": ["block_account", "cancel_order", "contact_bank", "report_to_authorities"],
        "allowedDomains": [
          { "pattern": "api.maxmind.com", "methods": ["GET"] },
          { "pattern": "*.fraud-detection.internal", "methods": ["GET", "POST"] }
        ],
        "dataRestrictions": {
          "denyPiiInParameters": true
        }
      },
      "status": "active",
      "createdAt": "2025-02-15T11:30:00Z"
    },
    {
      "id": "pol_rate_limit_api",
      "name": "API Rate Limiting",
      "description": "Enforce global rate limits to prevent abuse and cost overruns",
      "priority": 50,
      "scope": { "agentId": "*", "environment": ["production"] },
      "rules": {
        "allowedTools": [{ "toolName": "*" }],
        "rateLimit": {
          "maxRequestsPerMinute": 100,
          "maxRequestsPerHour": 5000,
          "burstSize": 20
        },
        "costLimit": {
          "maxPerRequest": 100,
          "maxPerDay": 10000,
          "currency": "USD"
        }
      },
      "status": "active",
      "createdAt": "2025-02-15T12:00:00Z"
    }
  ],
