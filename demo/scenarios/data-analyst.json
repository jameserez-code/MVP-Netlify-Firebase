  "policies": [
    {
      "id": "pol_read_only_sql",
      "name": "Read-Only SQL",
      "description": "Only SELECT queries allowed — no INSERT, UPDATE, DELETE, DROP, ALTER, or TRUNCATE",
      "priority": 10,
      "scope": { "agentId": "agent_sql_analyst_01" },
      "rules": {
        "allowedTools": [
          {
            "toolName": "db_query",
            "parameterConstraints": {
              "sql": {
                "type": "string",
                "pattern": "^(SELECT|WITH|EXPLAIN|DESCRIBE|SHOW)\\s",
                "maxLength": 4000
              }
            }
          },
          { "toolName": "explain_query", "parameterConstraints": { "sql": { "type": "string" } } },
          { "toolName": "schema_lookup", "parameterConstraints": { "table": { "type": "string" } } }
        ],
        "deniedTools": ["db_write", "db_delete", "db_drop", "db_alter", "db_truncate"],
        "dataRestrictions": {
          "denyPiiInParameters": true,
          "denySecretsInParameters": true,
          "sqlInjectionPatterns": [
            "UNION\\s+SELECT",
            "INTO\\s+OUTFILE",
            "--\\s*$",
            "/\\*.*\\*/"
          ]
        }
      },
      "status": "active",
      "createdAt": "2025-04-01T10:00:00Z"
    },
    {
      "id": "pol_sandbox_python",
      "name": "Sandboxed Python",
      "description": "Allow Python execution in sandbox only — no shell, no file system, no network",
      "priority": 10,
      "scope": { "agentId": "agent_python_analyst_02" },
      "rules": {
        "allowedTools": [
          {
            "toolName": "sandbox_run",
            "parameterConstraints": {
              "language": { "type": "string", "enum": ["python"] },
              "code": { "type": "string", "maxLength": 10000 },
              "timeout": { "type": "number", "max": 30 }
            }
          },
          {
            "toolName": "generate_chart",
            "parameterConstraints": {
              "type": { "type": "string", "enum": ["bar", "line", "scatter", "pie", "heatmap"] },
              "data": { "type": "string" }
            }
          },
          { "toolName": "statistical_test", "parameterConstraints": { "test": { "type": "string" }, "data": { "type": "string" } } }
        ],
        "deniedTools": ["shell_exec", "file_system_write", "file_system_read", "network_request", "subprocess_run"],
        "dataRestrictions": {
          "denyPiiInParameters": true,
          "denySecretsInParameters": true
        }
      },
      "status": "active",
      "createdAt": "2025-04-01T10:30:00Z"
    },
    {
      "id": "pol_no_raw_data_export",
      "name": "No Raw Data Export",
      "description": "Reports are allowed but raw data exports are blocked to prevent data leaks",
      "priority": 20,
      "scope": { "agentId": "*" },
      "rules": {
        "allowedTools": ["generate_report", "format_table", "create_visualization"],
        "deniedTools": ["export_csv", "export_json", "export_excel", "download_dataset", "email_data"],
        "dataRestrictions": {
          "denyPiiInParameters": true,
          "denySecretsInParameters": true
        }
      },
      "status": "active",
      "createdAt": "2025-04-01T11:00:00Z"
    },
    {
      "id": "pol_cost_control",
      "name": "Cost Control $200",
      "description": "Monthly budget cap for data analysis LLM calls",
      "priority": 30,
      "scope": { "agentId": "*" },
      "rules": {
        "costLimit": {
          "maxPerRequest": 200,
          "maxPerDay": 20000,
          "maxPerMonth": 500000,
          "currency": "USD",
          "alertThresholds": [0.5, 0.75, 0.9]
        }
      },
      "status": "active",
      "createdAt": "2025-04-01T11:30:00Z"
    }
  ],
