  "policies": [
    {
      "id": "pol_safe_web_search",
      "name": "Safe Web Search",
      "description": "Allow web searches but restrict to safe domains and deny PII in queries",
      "priority": 10,
      "scope": { "agentId": "agent_tier1_bot_01" },
      "rules": {
        "allowedTools": [
          {
            "toolName": "web_search",
            "parameterConstraints": {
              "query": { "type": "string", "maxLength": 200 }
            }
          }
        ],
        "deniedTools": ["execute_code", "send_email", "download_file"],
        "allowedDomains": [
          { "pattern": "*.wikipedia.org", "methods": ["GET"] },
          { "pattern": "*.stackoverflow.com", "methods": ["GET"] },
          { "pattern": "docs.helpdesk-ai.com", "methods": ["GET"] },
          { "pattern": "*.github.com", "methods": ["GET"] }
        ],
        "deniedDomains": ["*.darkweb.*", "localhost", "169.254.169.254", "*.onion"],
        "dataRestrictions": {
          "denyPiiInParameters": true,
          "denySecretsInParameters": true
        }
      },
      "status": "active",
      "createdAt": "2025-03-01T10:00:00Z"
    },
    {
      "id": "pol_read_only_crm",
      "name": "Read-Only CRM",
      "description": "Allow CRM lookups but block all mutations — no writes, deletes, or schema changes",
      "priority": 20,
      "scope": { "agentId": "agent_tier2_specialist_02" },
      "rules": {
        "allowedTools": [
          {
            "toolName": "lookup_customer",
            "parameterConstraints": {
              "customerId": { "type": "string", "pattern": "^CUST-[0-9]+$" }
            }
          },
          {
            "toolName": "lookup_order",
            "parameterConstraints": {
              "orderId": { "type": "string", "pattern": "^ORD-[0-9]+$" }
            }
          },
          {
            "toolName": "draft_email",
            "parameterConstraints": {
              "to": { "type": "string", "pattern": "^[^@]+@helpdesk-ai\\.com$" },
              "subject": { "type": "string", "maxLength": 200 }
            }
          }
        ],
        "deniedTools": [
          "db_write",
          "db_delete",
          "db_drop",
          "modify_customer",
          "cancel_order",
          "send_email",
          "bulk_email",
          "export_customer_data"
        ],
        "dataRestrictions": {
          "denyPiiInParameters": true,
          "denySecretsInParameters": true
        }
      },
      "status": "active",
      "createdAt": "2025-03-01T10:15:00Z"
    },
    {
      "id": "pol_no_pii",
      "name": "No PII Access",
      "description": "Strictly deny any access to personally identifiable information across all agents",
      "priority": 30,
      "scope": { "agentId": "*" },
      "rules": {
        "allowedTools": [],
        "deniedTools": [
          "access_customer_profile",
          "export_user_data",
          "lookup_ssn",
          "lookup_credit_card",
          "download_user_docs"
        ],
        "dataRestrictions": {
          "denyPiiInParameters": true,
          "piiPatterns": [
            "\\d{3}-\\d{2}-\\d{4}",
            "\\d{4}-\\d{4}-\\d{4}-\\d{4}",
            "[A-Z]{2}\\d{6,}"
          ],
          "denySecretsInParameters": true
        }
      },
      "status": "active",
      "createdAt": "2025-03-01T10:00:00Z"
    },
    {
      "id": "pol_email_templates_only",
      "name": "Email Templates Only",
      "description": "Allow drafting emails using approved templates; block outbound sending",
      "priority": 40,
      "scope": { "agentId": "agent_tier2_specialist_02" },
      "rules": {
        "allowedTools": [
          {
            "toolName": "draft_email",
            "parameterConstraints": {
              "templateId": {
                "type": "string",
                "enum": [
                  "tmpl_order_update",
                  "tmpl_shipping_delay",
                  "tmpl_refund_processed",
                  "tmpl_account_verification",
                  "tmpl_general_followup"
                ]
              },
              "to": { "type": "string", "pattern": "^[^@]+@helpdesk-ai\\.com$" }
            }
          }
        ],
        "deniedTools": ["send_email", "bulk_email", "schedule_email", "email_campaign"],
        "dataRestrictions": {
          "denyPiiInParameters": false,
          "denySecretsInParameters": true
        }
      },
      "status": "active",
      "createdAt": "2025-03-01T10:30:00Z"
    },
    {
      "id": "pol_cost_cap",
      "name": "Cost Cap $50",
      "description": "Enforce a $50 daily budget cap across all LLM calls for the organization",
      "priority": 50,
      "scope": { "agentId": "*", "environment": ["production"] },
      "rules": {
        "allowedTools": [
          {
            "toolName": "llm_generate",
            "parameterConstraints": {
              "model": { "type": "string" },
              "maxTokens": { "type": "number", "max": 1000 }
            }
          }
        ],
        "costLimit": {
          "maxPerRequest": 50,
          "maxPerDay": 5000,
          "currency": "USD"
        },
        "dataRestrictions": {
          "denySecretsInParameters": true
        }
      },
      "status": "active",
      "createdAt": "2025-03-01T11:00:00Z"
    }
  ],
