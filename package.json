{
  "name": "passport-agent",
  "version": "2.1.0",
  "description": "AI Agent Identity + Permission Control System",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/**/*.test.js",
    "test:integration": "tsx tests/integration/enforce.test.ts",
    "test:security": "tsx tests/integration/security.test.ts",
    "test:resilience": "tsx tests/integration/resilience.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:full-api": "tsx tests/integration/full-api.test.ts",
    "test:policy": "tsx tests/integration/policy.test.ts",
    "test:smoke": "tsx scripts/e2e-smoke-test.ts",
    "demo:lifecycle": "tsx demo/lifecycle.ts",
    "healthcheck": "tsx src/healthcheck.ts",
    "uptime:check": "tsx scripts/uptime-check.ts",
    "tasks:verify": "tsx src/tasks-verify.ts",
    "tasks:seed": "tsx src/tasks.ts",
    "schema:seed": "tsx src/seed.ts",
    "demo:seed": "tsx scripts/seed-demo.ts",
    "setup:prod": "tsx scripts/setup-production.ts",
    "migrate": "tsx scripts/migrate.ts",
    "dev": "tsx watch src/server.ts",
    "demo": "tsx src/demo-server.ts",
    "demo:guided": "tsx src/guided-demo.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "tui": "tsx src/tui.ts",
    "worker": "tsx src/worker.ts",
    "setup": "tsx src/bootstrap.ts",
    "prepare": "husky install",
    "lint": "eslint . --ext .ts,.js",
    "lint:fix": "eslint . --ext .ts,.js --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fastify/compress": "^8.3.1",
    "@fastify/multipart": "^10.0.0",
    "@types/ws": "^8.18.1",
    "fastify": "^5.8.5",
    "firebase-admin": "^12.0.0",
    "ioredis": "^5.10.1",
    "prom-client": "^15.1.3",
    "resend": "^6.12.3",
    "stripe": "^22.1.1",
    "tsx": "^4.21.0",
    "ws": "^8.20.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^8.57.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "prettier": "^3.2.5",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  }
}
