# Passport Agent — Quickstart Environment Variables
# =====================================================
# Copy this file to .env and fill in the required values.
#
# cp env.quickstart .env

# ---------------------------------------------------------------------------
# REQUIRED — Secrets (use `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
# ---------------------------------------------------------------------------
JWT_SECRET=dev_jwt_secret_replace_with_real_hex_64_chars
ENGINE_SECRET=dev_engine_secret_replace_with_real_hex_64_chars

# ---------------------------------------------------------------------------
# REQUIRED — Firebase (pick option A or B)
# ---------------------------------------------------------------------------
# Option A: Environment variables
FIREBASE_PROJECT_ID=demo-passport-agent
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@demo-passport-agent.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# Option B: Service account file (uncomment and set path)
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# ---------------------------------------------------------------------------
# OPTIONAL — Local Development
# ---------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# Redis (local Docker instance from docker-compose.quickstart.yml)
REDIS_URL=redis://localhost:6379

# Admin password for seed/demo scripts
ADMIN_PASSWORD=PassportDev2024!

# CORS origins for local frontend
ALLOWED_ORIGINS=http://localhost:3001

# ---------------------------------------------------------------------------
# OPTIONAL — Email (Resend)
# ---------------------------------------------------------------------------
# RESEND_API_KEY=re_your_test_key
# FROM_EMAIL=onboarding@resend.dev

# ---------------------------------------------------------------------------
# OPTIONAL — Stripe (test mode only)
# ---------------------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_APP_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# OPTIONAL — Monitoring & Error Tracking
# ---------------------------------------------------------------------------
# SENTRY_DSN=https://your-sentry-dsn
# LOG_LEVEL=debug
